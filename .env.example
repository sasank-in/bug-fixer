# Copy to .env and fill in. .env is gitignored; this file is not, so never put a
# real key here.
#
# Only `autoqa-fix` reads these. The fuzzer itself needs no key.

# Required for autoqa-fix. From https://ollama.com (Settings -> API keys).
OLLAMA_API_KEY=
OPEN_API_KEY=

# Optional. Any model your account can reach; a coder-tuned model does best.
# OLLAMA_MODEL=qwen2.5-coder:7b

# Optional. Override for a gateway or self-hosted endpoint.
# OLLAMA_BASE_URL=https://ollama.com
